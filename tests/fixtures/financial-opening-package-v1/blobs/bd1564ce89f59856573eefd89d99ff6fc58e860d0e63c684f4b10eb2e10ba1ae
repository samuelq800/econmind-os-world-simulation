def digest(data):
    return hashlib.sha256(data).hexdigest()


def decimal(value):
    value = Fraction(value)
    d = value.denominator
    a = b = 0
    while d % 2 == 0:
        d //= 2
        a += 1
    while d % 5 == 0:
        d //= 5
        b += 1
    assert d == 1, 'Only exact terminating sums of stored decimal values'
    places = max(a, b)
    n = value.numerator * 2 ** (places - a) * 5 ** (places - b)
    if not places:
        return str(n)
    s = str(abs(n)).zfill(places + 1)
    return ('-' if n < 0 else '') + (s[:-places] + '.' + s[-places:]).rstrip('0').rstrip('.')


def register(key, path, expected=None, layer='CONSTRUCTED', read=True, derived=False):
    path = Path(path)
    assert derived or (path != OUT and OUT not in path.parents)
    if read:
        data = path.read_bytes()
        actual = digest(data)
        if expected is not None:
            assert actual == expected, ('Changed selected input', key)
        size = len(data)
        state = 'SELECTED_INPUT_HASH_VERIFIED'
    else:
        actual = expected
        size = None
        state = 'UPSTREAM_POINTER_ONLY_NOT_DEREFERENCED_THIS_RUN'
    SOURCES[key] = {'sourceId': key, 'path': str(path), 'sha256': actual,
                    'bytes': size, 'evidenceClass': layer, 'verification': state}
    return path


def load(key, path, expected=None, layer='CONSTRUCTED'):
    path = register(key, path, expected, layer)
    # Keep numeric JSON token lexemes as strings; no binary-float conversion.
    value = json.loads(path.read_text(), parse_float=str)
    DOCS[key] = value
    return value


def ptr(doc, pointer):
    for token in pointer.split('/')[1:]:
        token = token.replace('~1', '/').replace('~0', '~')
        doc = doc[int(token)] if isinstance(doc, list) else doc[token]
    return doc


def fact(source, pointer, meaning, currency=None, unit=None):
    value = ptr(DOCS[source], pointer)
    if currency is not None:
        value = str(value)
    kind = 'DECIMAL_STRING' if currency is not None else 'NULL' if value is None else 'BOOLEAN' if isinstance(value, bool) else 'INTEGER' if isinstance(value, int) else 'STRING'
    return {'status': 'KNOWN_SOURCE_VALUE', 'evidenceClass': SOURCES[source]['evidenceClass'],
            'value': value, 'valueKind': kind, 'currency': currency, 'unit': unit, 'meaning': meaning,
            'source': {'sourceId': source, 'selector': {'kind': 'JSON_POINTER', 'pointer': pointer, 'originalValue': value}}}


def unknown(gap, source=None):
    if source is not None:
        UNKNOWN_EVIDENCE.append({'gapId': gap, 'locator': source, 'meaning': 'Pointer to missing/UNKNOWN token only, not a funding or authorization source'})
    return {'status': 'UNKNOWN', 'evidenceClass': None, 'value': None,
            'gapId': gap, 'source': None}


def csvcell(key, row, index, column, meaning, currency=None):
    assert column in row
    return {'status': 'KNOWN_SOURCE_VALUE', 'evidenceClass': SOURCES[key]['evidenceClass'],
            'value': row[column], 'valueKind': 'DECIMAL_STRING' if currency else 'STRING', 'currency': currency, 'unit': currency,
            'meaning': meaning, 'source': {'sourceId': key,
                'selector': {'kind':'CSV_CELL', 'dataRowZeroBased': index, 'physicalLine': index + 2,
                        'key': {'countryId': row['countryId'], **({'simDay': row['simDay']} if 'simDay' in row else {})},
                        'column': column, 'originalValue': row[column]}}}


def save(name, data):
    (OUT / name).write_text(json.dumps(data, ensure_ascii=False, indent=2) + '\n')


def ranges(indices):
    result = []
    for value in indices:
        if result and value == result[-1][1] + 1:
            result[-1][1] = value
        else:
            result.append([value, value])
    return result


