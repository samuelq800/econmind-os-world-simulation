    source = json.loads((OUT / 'SOURCE_REGISTRY.json').read_text())
    for row in source['sources']:
        if row['verification'] == 'SELECTED_INPUT_HASH_VERIFIED':
            assert digest(Path(row['path']).read_bytes()) == row['sha256']
    native = json.loads((OUT / 'NATIVE_LEAF_INDEX.json').read_text())
    native_source = next(x for x in source['sources'] if x['sourceId'] == 'native_lc')
    doc = json.loads(Path(native_source['path']).read_text())
    for row in native['leaves']:
        assert ptr(doc, row['nativeAmountPointer']) == row['amount']
        assert row['unit'] == 'LC' and row['spendableCash'] is False
    countries = json.loads((OUT / 'COUNTRY_SOURCE_REGISTRY.json').read_text())['countries']
    assert len(countries) == len({x['countryId'] for x in countries}) == 70
    assert all(not x['adoptedFacts'] and x['gcuCash']['availableGcu']['value'] is None for x in countries)
    clearing = json.loads((OUT / 'CLEARING_SOURCE_INDEX.json').read_text())
    assert len(clearing['claims']) == 4 and len(clearing['originalJournalPointers']) == 183
    assert source['consumerComposition']['requireAllBindingsTogether']
    assert source['consumerComposition']['guardFindingStatus'] == 'CLOSED_FOR_BASE_PLUS_FIXED_SUPPLEMENT'
    assert not source['adoptedFacts']
    print('PASS archive identities, native leaf pointers, country coverage, UNKNOWN and composition invariants; no economic replay')


