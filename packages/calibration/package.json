{
  "name": "@econmind/calibration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pilot:live": "pnpm build && node dist/pilot.js && pnpm exec prettier --write ../../data/calibration/pilot/*.json",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
