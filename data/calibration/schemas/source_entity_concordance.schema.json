{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://econmind.example/schemas/source-entity-concordance.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "status", "notes", "entities"],
  "properties": {
    "schemaVersion": { "const": "source-entity-concordance.v1" },
    "version": { "type": "string", "minLength": 1 },
    "status": { "const": "PILOT_NON_AUTHORITATIVE" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonicalEntityId", "displayName", "identifiers"],
        "properties": {
          "canonicalEntityId": {
            "type": "string",
            "pattern": "^emp:[A-Z0-9_-]+$"
          },
          "displayName": { "type": "string", "minLength": 1 },
          "identifiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["namespace", "value", "status"],
              "properties": {
                "namespace": { "type": "string", "minLength": 1 },
                "value": { "type": "string", "minLength": 1 },
                "status": { "enum": ["VERIFIED", "PILOT", "UNRESOLVED"] }
              }
            }
          }
        }
      }
    }
  }
}
