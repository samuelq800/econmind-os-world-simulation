{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://econmind.example/schemas/v10-data-handoff-readiness-contract.v1.json",
  "title": "V10 data-handoff readiness policy contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "contractId",
    "status",
    "baseline",
    "inputArtifacts",
    "closureEvidenceEnvelope",
    "gates",
    "hardBoundaries"
  ],
  "properties": {
    "schemaVersion": { "const": "v10-data-handoff-readiness-contract.v1" },
    "contractVersion": { "const": "1.0.0" },
    "contractId": { "type": "string", "minLength": 1 },
    "status": { "const": "PREPARATION_ONLY_NON_AUTHORITATIVE" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosticsTargetCommit",
        "diagnosticsContentHash",
        "v10StatusMustRemain",
        "finalGeneratorReady"
      ],
      "properties": {
        "diagnosticsTargetCommit": { "$ref": "#/$defs/commit" },
        "diagnosticsContentHash": { "$ref": "#/$defs/hash" },
        "v10StatusMustRemain": { "const": "PLANNED" },
        "finalGeneratorReady": { "const": false }
      }
    },
    "inputArtifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/artifactBinding" }
    },
    "closureEvidenceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requiredDecision",
        "requiredArtifactBindingCountMinimum",
        "selfCreatedImplementationReportIsAuthority",
        "independentReviewRequired"
      ],
      "properties": {
        "schemaVersion": { "const": "v10-gate-closure-evidence.v1" },
        "requiredDecision": { "const": "APPROVED" },
        "requiredArtifactBindingCountMinimum": { "const": 1 },
        "selfCreatedImplementationReportIsAuthority": { "const": false },
        "independentReviewRequired": { "const": true }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/gate" }
    },
    "hardBoundaries": { "$ref": "#/$defs/stringSet" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rawSha256", "canonicalHash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "rawSha256": { "$ref": "#/$defs/hash" },
        "canonicalHash": { "$ref": "#/$defs/hash" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "description"],
      "properties": {
        "requirementId": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "nullableRequirement": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/requirement" }]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "satisfiedComputableEvidenceIds",
        "requiredOwnerDecision",
        "requiredNewSourceOrCredential",
        "requiredGovernanceAuthorization",
        "dependsOnGateIds",
        "allowedNextAction",
        "prohibitedAuthorityInterpretation"
      ],
      "properties": {
        "gateId": { "type": "string", "minLength": 1 },
        "satisfiedComputableEvidenceIds": { "$ref": "#/$defs/stringSet" },
        "requiredOwnerDecision": { "$ref": "#/$defs/nullableRequirement" },
        "requiredNewSourceOrCredential": {
          "$ref": "#/$defs/nullableRequirement"
        },
        "requiredGovernanceAuthorization": {
          "$ref": "#/$defs/nullableRequirement"
        },
        "dependsOnGateIds": { "$ref": "#/$defs/stringSet" },
        "allowedNextAction": { "type": "string", "minLength": 1 },
        "prohibitedAuthorityInterpretation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
