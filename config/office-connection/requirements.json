  "acceptanceRequirements": [
    {
      "id": "AUTHORITY",
      "requiredEvidence": "Adopted current source identity, revision, fingerprint, units, custody and admission. A specification or selected source alone is insufficient."
    },
    {
      "id": "API_DATABASE",
      "requiredEvidence": "Exact browser DTO and route to authoritative database reader/writer; null until traced for this field or action."
    },
    {
      "id": "ISOLATION",
      "requiredEvidence": "Server verified JWT, current seat/team and authorization revision, admission, world/country/office/classification; normal cross-scope denial checks."
    },
    {
      "id": "IDEMPOTENCY",
      "requiredEvidence": "Same command/idempotency key returns original immutable outcome; conflicting payload rejected; unknown write outcome uses original lookup."
    },
    {
      "id": "CONCURRENCY",
      "requiredEvidence": "Atomic authoritative events/postings/receipt/head with lease/fence, expected head and cooperating source protection; rollback and competing ordinary requests."
    },
    {
      "id": "AUDIT",
      "requiredEvidence": "Command fingerprint, append-only events, posting IDs, final receipt, head and outbox provenance."
    },
    {
      "id": "READBACK",
      "requiredEvidence": "Authorized browser FINAL lookup and projection refresh at least the receipt head, exact values and units; queue acknowledgement is not success."
    },
    {
      "id": "PERSISTENCE",
      "requiredEvidence": "Independent session/reload reads durable final outcome and values from the authoritative database; browser localStorage does not satisfy this."
    }
