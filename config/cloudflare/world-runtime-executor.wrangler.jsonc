{
  "name": "econmind-world-executor-runtime",
  "main": "../../apps/world-worker/src/runtime-preparation/hold-executor.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.01 },
  "env": {
    "staging": {
      "name": "econmind-world-executor-staging",
      "workers_dev": false,
      "vars": { "RUNTIME_MODE": "HOLD" },
    },
  },
}
