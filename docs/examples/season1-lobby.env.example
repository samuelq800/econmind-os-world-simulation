# Server-only preparation. Do not source this into world-web or commit real keys.
# This file does not activate an HTTP route or connect to a database.
# Confirm the recent Season 1 source using the connection-preparation runbook.
# Fill all three in the deployment's server configuration; empty values fail closed.
# URL must be exactly https://<project-ref>.supabase.co with no path or trailing slash.
WORLD_LOBBY_SUPABASE_PROJECT_REF=
WORLD_LOBBY_SUPABASE_URL=
# A publishable key or legacy anon public JWT only; never a service-role/secret key.
WORLD_LOBBY_SUPABASE_PUBLISHABLE_KEY=
# The user's access token belongs to each authenticated request, not this file.
# Never set WORLD_LOBBY_SUPABASE_SERVICE_ROLE_KEY or WORLD_LOBBY_SUPABASE_SECRET_KEY.
