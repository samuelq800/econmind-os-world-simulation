{
  "name": "econmind-os-world-simulation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.20.0",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "preinstall": "node scripts/verify-toolchain.mjs",
    "dev": "node scripts/run-development-stack.mjs",
    "dev:web": "node scripts/run-development-service.mjs web",
    "dev:api": "node scripts/run-development-service.mjs api",
    "dev:worker": "node scripts/run-development-service.mjs worker",
    "pretest": "pnpm --filter @econmind/world-api build && pnpm --filter @econmind/world-worker build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:property": "vitest run tests/property",
    "test:architecture": "vitest run tests/architecture && node scripts/check-boundaries.mjs && node scripts/check-authoritative-patterns.mjs",
    "test:boundaries": "vitest run tests/architecture/boundaries.test.ts tests/architecture/foundation-gates.test.ts tests/architecture/foundation-ci-gate.test.ts && node scripts/check-authoritative-patterns.mjs && node scripts/check-boundaries.mjs",
    "foundation:policy": "node scripts/foundation-gate-policy.mjs",
    "env:check": "ECONMIND_ENV=local node scripts/assert-safe-environment.mjs",
    "migration:validate": "node scripts/validate-migrations.mjs",
    "migration:rehearse": "node scripts/rehearse-migrations.mjs",
    "test:v09:postgres": "node scripts/v09-postgres-test-environment.mjs && vitest run tests/world-core/world-writer-lease-postgres.test.ts",
    "v09:staging:plan": "node scripts/v09-staging-evidence.mjs --dry-run",
    "registry:generate": "python3 tools/build_core_registries.py && prettier --write packages/core/src/registries/fixed-catalog.ts",
    "secrets:check": "node scripts/check-repository-secrets.mjs",
    "supabase:safe": "node scripts/supabase-safe.mjs",
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:boundaries && pnpm env:check && pnpm migration:validate && pnpm migration:rehearse && pnpm foundation:policy && pnpm secrets:check && pnpm build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "fast-check": "4.9.0",
    "globals": "17.12.0",
    "pg": "8.16.3",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
