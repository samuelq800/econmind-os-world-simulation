{
  "name": "econmind-os-world-simulation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.20.0",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "preinstall": "node scripts/verify-toolchain.mjs",
    "dev:web": "node scripts/run-development-service.mjs web",
    "dev:api": "node scripts/run-development-service.mjs api",
    "dev:worker": "node scripts/run-development-service.mjs worker",
    "pretest": "pnpm --filter @econmind/world-api build && pnpm --filter @econmind/world-worker build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:boundaries": "vitest run tests/architecture/boundaries.test.ts && node scripts/check-boundaries.mjs",
    "env:check": "node scripts/assert-safe-environment.mjs",
    "secrets:check": "node scripts/check-repository-secrets.mjs",
    "supabase:safe": "node scripts/supabase-safe.mjs",
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:boundaries && pnpm env:check && pnpm secrets:check && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
