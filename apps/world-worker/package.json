{
  "name": "@econmind/world-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./intake": {
      "types": "./dist/intake/postgres-narrow-transfer-intake.d.ts",
      "default": "./dist/intake/postgres-narrow-transfer-intake.js"
    },
    "./approval-store": {
      "types": "./dist/persistence/narrow-transfer-approval-store.d.ts",
      "default": "./dist/persistence/narrow-transfer-approval-store.js"
    },
    "./runtime-read-binding-store": {
      "types": "./dist/persistence/runtime-read-binding-store.d.ts",
      "default": "./dist/persistence/runtime-read-binding-store.js"
    }
  },
  "scripts": {
    "dev": "node ../../scripts/run-development-service.mjs worker",
    "start": "node ../../scripts/run-development-service.mjs worker start",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@econmind/core": "workspace:*",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "typescript": "6.0.3"
  }
}
